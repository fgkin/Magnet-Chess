  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "TEK OYUNCULU\r\n\u201CYerel Oyun\" butonuna basarak hemen oyuna ba\u015Flayabilirsin.\r\n\r\n\xC7OK
    OYUNCULU\r\n1. \u201C\xC7OK OYUNCULU\u201D butonuna bas.\r\n2. Yeni oyun i\xE7in
    \u201CLOBI OLU\u015ETUR\u201D se\xE7.\r\n3. Arkada\u015F\u0131n lobiyi listeden
    se\xE7ip \u201CKATIL\u201D butonuna bass\u0131n.\r\n4. Herkes \u201CHAZIR\u201D
    butonuna bass\u0131n.\r\n5. Lobi sahibi \u201COYUNU BA\u015ELAT\u201D butonuna
    bass\u0131n.\r\n\r\nOYUN \u0130\xC7\u0130NDE\r\nS\u0131ra sana geldi\u011Finde
    kendi m\u0131knat\u0131slar\u0131n\u0131 oyun alan\u0131na s\xFCr\xFCkle."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
